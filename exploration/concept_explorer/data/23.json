  "parameter_metadata": {},
  "narrative": {
    "key_bets": [
      "p-B11 ignition and net gain (Q≥1) achievable via non-thermal laser-target interaction, despite HB11 demonstrating only ~0.005% laser-to-alpha efficiency (~4 orders of magnitude gap)",
      "Laser wall-plug efficiency of ~10% for DPSSL drivers at 10 Hz continuous petawatt-class operation, versus <1% in current high-power lasers",
      "Laser diode cost reduction from $0.3–$1.3/W to $0.01/W target (30–130× decrease) contingent on ~1,000× production volume scale-up",
      "Diode pump lifetime of 3–20 Gshots over plant life, versus ~1–2 Gshots currently demonstrated",
      "~500 simultaneously operating DPSSL systems at 10 Hz with femtosecond pulses and petawatt peak powers (Marvel commercial plant)",
      "Hybrid direct energy conversion capturing fast alpha particles at ~70% efficiency in pulsed burst mode (Marvel), with no built analogue",
      "Target fabrication at <$0.03/target for 864,000 targets/day via semiconductor lithography at commercial-relevant yield and throughput"
    ],
    "eliminated_costs": [
      "No tritium breeding blanket — eliminates FLiBe/LiPb blanket CAPEX and TBR>1 constraint",
      "No superconducting magnets — eliminates REBCO/HTS tape supply chain and cryogenic infrastructure",
      "No beryllium or enriched Li-6 — eliminates exotic breeder chemistry and criticality risk",
      "No heavy neutron shielding or remote-handling infrastructure — aneutronic environment enables standard steel construction and hands-on maintenance",
      "Reduced first-wall replacement cost — no 14 MeV neutron activation; plant-lifetime first wall (vs ~3–5 year D-T replacement)"
    ],
    "novel_costs": [
      "~500-system DPSSL laser driver fleet at 10 Hz petawatt-class — dominant CAPEX with no cost-per-joule literature benchmark",
      "Hybrid magnetic + electrostatic alpha-particle direct energy converter — unprecedented pulsed burst-mode system with no demonstrated hardware",
      "Target factory producing 864,000 nanostructured silicon targets/day via semiconductor lithography at sub-cent unit cost",
      "Laser diode pump replacement/lifetime cost at 3–20 Gshot requirement — no qualification standard, facet passivation at scale undemonstrated",
      "Petawatt-class final-optic damage and replacement at 10 Hz continuous (distinct damage physics from NIF nanosecond analogue)"
    ],
    "risks": [
      {
        "description": "p-B11 ignition and gain physics unvalidated — 4 orders of magnitude gap between HB11 demonstrated 0.005% conversion and net energy gain; Marvel has no published yield data",
        "severity": "high"
      },
      {
        "description": "Laser diode market formation deadlock — $0.01/W target requires ~1,000× production scale-up that itself depends on IFE deployment, creating a chicken-and-egg programmatic risk not resolvable by lab results",
        "severity": "high"
      },
      {
        "description": "Diode pump lifetime 1.5–10× below minimum IFE requirement with no qualification standards and undemonstrated facet passivation for multi-junction bars at commercial scale",
        "severity": "high"
      },
      {
        "description": "Hybrid direct energy conversion at ~70% efficiency is unvalidated — HB11 already pivoted to conventional steam cycle (~35%) due to engineering intractability; 2× LCOE lever with neither endpoint validated",
        "severity": "high"
      },
      {
        "description": "Plant availability has dominant LCOE elasticity (≈−1.0) with no operational analogue for 10 Hz pulsed laser IFE — current 75% assumption is an unbounded placeholder",
        "severity": "high"
      },
      {
        "description": "Laser capital cost per joule at 10 Hz continuous operation unbounded — no published cost-per-joule data for commercial-duty-cycle DPSSL; 500-laser plant CAPEX cannot be bounded",
        "severity": "high"
      },
      {
        "description": "10 Hz target injection with micron-level alignment precision for nanostructured targets has no current demonstration",
        "severity": "medium"
      },
      {
        "description": "Target fabrication economics at 864,000/day unverified — Marvel's <$0.03/target ceiling requires >99% yield at commercial-rate semiconductor fab throughput with no published cost data",
        "severity": "medium"
      },
      {
        "description": "B-11 enrichment requirement unconfirmed — if required, current isotope separation industry at kg/year scale cannot serve tonne/year plant demand",
        "severity": "medium"
      },
      {
        "description": "Laser optic damage at 10 Hz petawatt femtosecond operation has no direct analogue; NIF ns-pulse optics cost ($5.6M/yr replacement) is order-of-magnitude reference only due to distinct ultrashort-pulse damage physics",
        "severity": "medium"
      },
      {
        "description": "O&M cost structure (elasticity 0.204, highest engineering-lever elasticity) has no sourced basis — framework default placeholder dominates LCOE more than laser driver capital",
        "severity": "medium"
      },
      {
        "description": "Financial parameters (interest rate elasticity 0.65, construction time 0.27) dominate LCOE for capital-intensive FOAK plant with no near-term plant design to anchor construction schedule",
        "severity": "medium"
      },
      {
        "description": "HB11 underfunded at ~$22M vs Marvel's EUR 385M — limits experimental pace for the company with operational hardware",
        "severity": "low"
      },
      {
        "description": "UNSW first-wall/chamber materials collaboration is early-stage; no published lifetime data under alpha flux",
        "severity": "low"
      }
    ]
  },
