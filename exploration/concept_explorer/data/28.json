  "narrative": {
    "key_bets": [
      "Full HTS coil set (TF + PF + CS in REBCO) operates reliably at 25 T peak field under cyclic EM loading",
      "AI-based plasma control extends from 1,337-second HH70 demonstration to burning-plasma conditions with high availability",
      "Compact high-field geometry (~14 T on-axis, ~70% SPARC volume) achieves Q > 10 at HH170 scale and scales to commercial HH380",
      "China-domestic supply chain (>95% localization, Shanghai Superconductor REBCO) scales from prototype to commercial volume without significant cost increase",
      "Tritium breeding blanket can be developed for HH380 despite no concept being disclosed today (TRL 1-2)",
      "Co-founder's strategic LCOE target (at or below thermal power) is achievable with undisclosed power conversion cycle and undisclosed net electric output",
      "Jingtian 21.7 T test magnet result translates to commercial-scale 25 T D-shaped HTS coil sets with manufacturing consistency"
    ],
    "eliminated_costs": [
      "Smaller machine size (~70% SPARC volume) reduces structural material, building volume, and site footprint vs. ITER-scale large tokamaks",
      "Uniform 20 K cryoplant across all coils eliminates mixed LTS/HTS cryogenic circuits and dual-temperature thermal management",
      "China-domestic supply chain (>95% localization) eliminates international logistics costs and export-control friction for domestic deployment",
      "Shorter build time (HH70 built in <2 years) reduces interest-during-construction (IDC) burden vs. decade-plus conventional tokamak builds",
      "AI-enabled steady-state operation potentially eliminates pulsed-operation thermal cycling costs and disruption-driven repair costs"
    ],
    "novel_costs": [
      "Incremental REBCO tape demand for full HTS PF + CS coils beyond TF-only HTS competitors (hts_full_coil_premium ×1.1-×1.3 on C220103)",
      "Full HTS CS coil reconditioning or replacement under cyclic EM loading at 25 T (no published fatigue data exists globally)",
      "Quench protection system for a 26+-coil full-HTS configuration in a neutron environment (no precedent)",
      "AI plasma control system radiation hardening and redundancy for HH380-scale burning-plasma operation",
      "Higher REBCO tape performance requirements at 25 T / 20 K for compact high-field coils vs. lower-field HTS designs"
    ],
    "risks": [
      {
        "description": "No commercial design point exists for HH380 — no published net electric output, fusion power, Q, blanket design, or capital cost; LCOE model has no anchor and carries ±50% or greater uncertainty",
        "severity": "high"
      },
      {
        "description": "Tritium breeding blanket entirely undisclosed (TRL 1-2 for company-specific approach); structurally unresolvable until HH380 engineering phase post-2030",
        "severity": "high"
      },
      {
        "description": "Full HTS CS coils at 25 T under cyclic EM loading have no published fatigue or reliability data globally; CS coil reliability failure scenario projects ~+14-22% LCOE impact",
        "severity": "high"
      },
      {
        "description": "Gap from validated 21.7 T (Jingtian) to 25 T target for HH170 is non-trivial — REBCO Jc falls rapidly above 20 T at 20 K and Lorentz forces scale proportionally",
        "severity": "high"
      },
      {
        "description": "AI-based plasma control unvalidated at burning-plasma conditions (high neutron flux, sensor degradation, D-T disruption precursors); base case 80% availability assumption unsupported",
        "severity": "medium"
      },
      {
        "description": "ICRH at tens-of-MW scale for burning plasma has different efficiency, reliability, and antenna engineering challenges than HH70 prototype levels; no heating configuration disclosed for HH170/HH380",
        "severity": "medium"
      },
      {
        "description": "Power conversion cycle type and thermal efficiency entirely undisclosed; placeholder 40% steam Rankine assumption may not match achievable design",
        "severity": "medium"
      },
      {
        "description": "Chinese regulatory framework for fusion power plants is still being formulated; international harmonization uncertain; may limit access to international markets",
        "severity": "medium"
      },
      {
        "description": "Shanghai Superconductor current REBCO capacity below fleet-scale demand; tape cost must fall from ~$30-100/kA-m to ~$10/kA-m for commercial viability",
        "severity": "medium"
      },
      {
        "description": "HH170 'D-T equivalent' framing suggests D-T may not be burned in that machine, leaving the commercial Q demonstration path uncertain before HH380",
        "severity": "medium"
      },
      {
        "description": "Energy Singularity is among the least transparent private fusion companies — three research iterations and 20+ sources yielded no commercial design parameters",
        "severity": "medium"
      },
      {
        "description": "Opaque cost basis from China-domestic supply chain creates barriers to international cost benchmarking and validation",
        "severity": "low"
      }
    ]
  },
