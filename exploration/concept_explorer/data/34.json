  "narrative": {
    "key_bets": [
      "Compact spherical tokamak architecture (low aspect ratio ~2.2) can achieve commercially viable D-T fusion at small scale",
      "HTS magnets enable sufficient field strength in a compact geometry to reach net electric output at 50 MWe per module",
      "Modular 50 MWe units deployed at fleet scale (2,500 modules → 125 GW) achieve cost competitiveness through factory learning curves",
      "Steady-state operation is achievable in a compact ST despite typical ST preference for pulsed operation",
      "Outboard-only blanket geometry in a small ST can achieve tritium self-sufficiency (TBR > 1) with Li-6 enriched breeder",
      "Jenga digital twin platform can substitute for extensive physical prototyping by integrating MHD, transport, neutronics, and plant-level modeling",
      "Indian private-sector development can bridge the supply chain gap for HTS tape, Li-6, and tritium without domestic production base"
    ],
    "eliminated_costs": [
      "Utility-scale steam turbine cost (50 MW industrial turbomachinery is cheaper in absolute terms than 500 MW+ utility turbines)",
      "Site-specific large civil works of GW-scale plants (modular factory-built units shift cost from site construction to factory production)",
      "Per-unit FOAK engineering cost amortized across 2,500 modules via Wright's Law learning curve",
      "Large single-plant financing risk replaced by incremental module-by-module deployment"
    ],
    "novel_costs": [
      "Severe small-scale capital cost penalty (~2.5–3× $/kWe vs 500 MWe ST due to fixed/sublinear cost components like tritium fuel cycle, center stack shielding, site infrastructure)",
      "Extreme recirculating power fraction (~50–60% of gross electric at 50 MWe) requiring fusion power of 250–400 MW to deliver 50 MWe net",
      "Fleet-scale tritium startup inventory (~2,500 kg for 2,500 units) far exceeding global tritium availability of 25–30 kg",
      "India import dependency for all critical materials (REBCO tape, Li-6, tritium) creating supply chain and geopolitical cost premium",
      "Indian regulatory uncertainty premium (AERB has no fusion-specific pathway; potential 2.2× building cost penalty under fission-style regulation)"
    ],
    "risks": [
      {
        "description": "No published machine parameters (R, A, B_T, Q, plasma current) — entire LCOE model rests on ST analogues with no concept-specific anchor",
        "severity": "high"
      },
      {
        "description": "Extreme recirculating power fraction (~50–60%) at 50 MWe scale makes concept acutely sensitive to any degradation in heating efficiency, Q, or system reliability",
        "severity": "high"
      },
      {
        "description": "Modular 50 MWe scale falls outside all existing fusion TEA frameworks (ARIES, PROCESS, Araiinejad & Shirvan), requiring extrapolation across 5–20× output where economies of scale are most punishing",
        "severity": "high"
      },
      {
        "description": "Factory learning curve thesis requires demonstrated FOAK plant performance before fleet commitment — staging problem unaddressed in public documentation",
        "severity": "high"
      },
      {
        "description": "Tritium supply chain: India has no domestic CANDU/tritium production; fleet-scale startup demands (~2,500 kg) vastly exceed global inventory (25–30 kg)",
        "severity": "high"
      },
      {
        "description": "HTS specifications undisclosed (field strength, coil count, REBCO vs BSCCO tape grade) — magnet capital cost (20–40% of direct capital) remains under-constrained despite type confirmation",
        "severity": "high"
      },
      {
        "description": "Heating method not disclosed — Q_engineering and recirculating power cannot be computed for any design point",
        "severity": "high"
      },
      {
        "description": "Blanket and tritium breeding approach entirely uncharacterized; outboard-only ST geometry constrains TBR > 1 achievability",
        "severity": "high"
      },
      {
        "description": "India regulatory landscape blank for private fusion (AERB no established pathway); potential 2.2× building cost penalty under fission-style regulation",
        "severity": "medium"
      },
      {
        "description": "REBCO tape supply chain: no domestic Indian production; full import dependency on Japan/China/US for fleet-scale demand (thousands of km per unit × 2,500 units)",
        "severity": "medium"
      },
      {
        "description": "Li-6 enrichment supply controlled by Russia and China (mercury amalgam process banned in West); India lacks domestic isotope separation capability",
        "severity": "medium"
      },
      {
        "description": "Funding gap vs nearest neighbor Tokamak Energy ($335M vs $417K confirmed / ~$6.8M reported) and ~10–15 year development gap (PRAGYA 0.1 T experimental device vs Demo4 11.8 T validated coil set)",
        "severity": "medium"
      },
      {
        "description": "Jenga digital twin has no published validated outputs — design point parameters cannot be inferred from modeling work in progress",
        "severity": "low"
      },
      {
        "description": "Steady-state operation declared but ST family typically prefers pulsed mode; achieving steady-state requires high bootstrap fraction or substantial current drive power",
        "severity": "low"
      }
    ]
  },
