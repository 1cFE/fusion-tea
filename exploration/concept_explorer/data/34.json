  "parameter_metadata": {},
  "narrative": {
    "key_bets": [
      "Compact spherical tokamak (ST) geometry with low aspect ratio (A≈2) achieves commercial viability at 50 MWe scale",
      "HTS magnet technology delivers sufficient field strength for compact ST operation despite India's absence of domestic REBCO supply",
      "Factory learning across 2,500 modular units compresses per-unit capital cost via Wright's Law (≥15-20% reduction per doubling)",
      "Outboard-only tritium breeding blanket achieves TBR > 1 despite center stack geometry constraint",
      "Jenga digital twin platform substitutes computational design maturity for experimental validation",
      "Distributed 50 MWe modular deployment model is economically competitive despite severe scale penalty (~2.5-3× $/kWe vs 500 MWe)",
      "Steady-state operation is achievable in compact ST geometry without pulsed thermal storage"
    ],
    "eliminated_costs": [
      "Utility-scale steam turbine BOP — 50 MW industrial turbomachinery is cheaper in absolute terms than GW-scale turbines",
      "Large site civil infrastructure — modular factory-built units avoid bespoke plant-scale construction",
      "Thermal energy storage buffering — steady-state operation avoids pulsed-mode storage requirements"
    ],
    "novel_costs": [
      "Factory tooling and assembly line capital for 2,500-unit modular production",
      "Jenga digital twin platform development and validation (MHD, transport, neutronics, thermal-structural, PMI integration)",
      "India-specific import logistics for REBCO tape, Li-6 enriched breeder, and tritium (no domestic supply chain)",
      "AERB regulatory pathway development — no established framework for private fusion in India (potential 2.2× building cost markup)",
      "Severe recirculating power fraction (~50-60% of gross electric) driving oversized auxiliary systems at 50 MWe net scale"
    ],
    "risks": [
      {
        "description": "Severe scale penalty at 50 MWe — fixed-cost fusion plant elements (tritium cycle, shielding, BOP) drive ~2.5-3× $/kWe vs 500 MWe ST reference",
        "severity": "high"
      },
      {
        "description": "Recirculating power fraction of 50-60% at 50 MWe net output leaves concept acutely sensitive to any heating efficiency or Q degradation",
        "severity": "high"
      },
      {
        "description": "No disclosed machine parameters (R, A, B_T, Q, Ip) for commercial design — entire physics-to-LCOE chain cannot be closed",
        "severity": "high"
      },
      {
        "description": "Factory learning thesis requires validated FOAK performance before 2,500-unit fleet commitment — staging problem unaddressed",
        "severity": "high"
      },
      {
        "description": "India AERB has no established private fusion regulatory pathway; fission-style regulation could impose 2.2× building cost markup",
        "severity": "high"
      },
      {
        "description": "Total import dependency for REBCO tape, Li-6 enriched lithium, and tritium — no domestic Indian supply chain",
        "severity": "high"
      },
      {
        "description": "Tritium startup inventory for 2,500-unit fleet (~2,500 kg) vastly exceeds global inventory (~25-30 kg) without demonstrated self-sufficient breeding",
        "severity": "high"
      },
      {
        "description": "Outboard-only breeding blanket geometry in compact ST provides limited solid angle for TBR > 1, exacerbated at small aspect ratio",
        "severity": "medium"
      },
      {
        "description": "Massive maturity gap between PRAGYA (0.1 T experimental device) and commercial ST (2-5 T) — approximately 10-15 year development path",
        "severity": "high"
      },
      {
        "description": "Funding position (~$417K confirmed, ~$6.8M reported but unverified) is 2-3 orders of magnitude below nearest-neighbor Tokamak Energy ($335M)",
        "severity": "medium"
      },
      {
        "description": "Heating method undisclosed — Q_engineering and recirculating power cannot be bounded",
        "severity": "medium"
      },
      {
        "description": "No tritium breeding blanket design disclosed — self-sufficiency unquantified for D-T operation",
        "severity": "medium"
      },
      {
        "description": "HTS operating point (field strength, coil count, tape grade) unpublished despite HTS technology confirmation",
        "severity": "medium"
      },
      {
        "description": "Jenga digital twin has no published validated outputs — computational design maturity unverifiable",
        "severity": "medium"
      }
    ]
  },
