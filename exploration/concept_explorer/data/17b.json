  "narrative": {
    "key_bets": [
      "Proton coupling efficiency (petawatt laser → proton beam → compressed hot spot) reaches ~15% or higher at ignition-relevant areal densities",
      "Fast ignition achieves gain G = 50–100 at commercial scale, despite no FI experiment ever exceeding G > 1",
      "DPSSL compression laser operates continuously at 10 Hz with ~10% wall-plug efficiency and diode cost floor near $0.01/W",
      "Petawatt ignition laser scales to 10 Hz at ~150 kJ picosecond pulses — never demonstrated (T-STAR starts at 1 shot/60 s)",
      "Cone-in-shell Pearl™ targets can be mass-produced at 900,000/day (~800,000× NIF's current rate) with adequate cone alignment surviving implosion",
      "Chamber clears debris within ~100 ms between shots despite asymmetric cone-in-shell explosion debris",
      "Meier 2006 FI economic advantage over CHS (~15% lower COE) holds even when ignitor laser carries real capital cost"
    ],
    "eliminated_costs": [
      "Symmetry-control overhead associated with indirect-drive hohlraums (direct/fast ignition relaxes symmetry requirements per Optica OPN)",
      "Single-driver gain requirement — FI offloads ignition from the compression driver, reducing compression laser energy vs. pure CHS direct drive",
      "Exotic power conversion R&D — conventional Rankine steam cycle reuses mature fossil/fission BOP infrastructure"
    ],
    "novel_costs": [
      "Petawatt ignition laser as a second, independent capital line item (Ti:sapphire or OPCPA at 10 Hz, 150 kJ) with no commercial precedent",
      "Cone-in-shell Pearl™ target fabrication — asymmetric geometry with embedded high-Z (likely gold) cone at 900,000 targets/day",
      "Gold (or alternative high-Z) cone material supply chain — ~30 tonnes/year at 1 mg/cone if gold is required",
      "Dual-laser supply chain, maintenance rhythms, and final optics protection for two fundamentally different laser systems",
      "Specialized targetry QC infrastructure to verify cone alignment tolerances surviving implosion pre-ignition"
    ],
    "risks": [
      {
        "description": "Proton coupling efficiency (η_coup) never measured at ignition-relevant conditions; spans ~5–30%; below ~7% ignition fails (q_eng < 1)",
        "severity": "high"
      },
      {
        "description": "Fast ignition gain > 1 not demonstrated at any scale; Focused Energy G = 50–100 target falls below both energetics (G > 100) and economic competitiveness (G > ~400, Hawker 2020) thresholds",
        "severity": "high"
      },
      {
        "description": "Petawatt ignition laser cost ($/J) at 10 Hz is unquantified; FI economic advantage over CHS may be eliminated once ignitor carries a positive $/J premium",
        "severity": "high"
      },
      {
        "description": "No chamber design disclosed; 10 Hz clearing with asymmetric cone-in-shell debris is more demanding than Xcimer's sub-Hz FLiBe concept",
        "severity": "high"
      },
      {
        "description": "Blanket type and TBR undisclosed; tritium self-sufficiency cannot be verified",
        "severity": "high"
      },
      {
        "description": "Cone-in-shell target mass production at 900,000/day represents ~800,000× scale-up from NIF; no demonstrated process exists",
        "severity": "high"
      },
      {
        "description": "Final optics protection scheme at 10 Hz undisclosed; DPSSL architecture lacks Xcimer's nonlinear-gas-optics option; damage accumulates rapidly",
        "severity": "high"
      },
      {
        "description": "DPSSL diode cost floor requires 10–100× reduction from current $0.1–1/W to meet ~$0.01/W target",
        "severity": "medium"
      },
      {
        "description": "T-STAR petawatt runs at 1 shot/60 s; scaling to 10 Hz requires thermal management of Ti:sapphire/OPCPA at unprecedented average power",
        "severity": "medium"
      },
      {
        "description": "O&M structure unpublished; 10 Hz shot-cycle fatigue on optics/beam delivery likely drives O&M to 5–8% of CAPEX/yr vs. ~2% framework default",
        "severity": "medium"
      },
      {
        "description": "Capacity factor undisclosed; pulsed-system availability is the highest-elasticity LCOE lever (−0.95)",
        "severity": "medium"
      },
      {
        "description": "Gold cone material supply (~30 tonnes/year) creates non-negligible global demand if reduced-gold designs fail to validate",
        "severity": "low"
      }
    ]
  },
