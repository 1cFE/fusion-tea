  "narrative": {
    "key_bets": [
      "Active-target ML-optimized muon source reduces production energy from ~6 GeV to 2.5–3 GeV per muon",
      "Achieving 200–300 fusions per muon at high-temperature, high-density operating conditions (800–1300 K)",
      "Effective alpha-sticking probability remains at 0.3–0.5%, permitting fusions/muon ceiling of 200–350",
      "CW superconducting GeV-class proton accelerator achievable at power-plant scale with 47% recirculating power fraction",
      "Commercial-scale fusion chamber architecture replacing the diamond anvil cell (e.g., compressed gas / shock-wave compression target)",
      "Tritium-breeding blanket with TBR > 1 integrated with non-plasma material-containment chamber",
      "Brayton (likely sCO₂) BOP at 500–1000°C delivering ~50% thermal-to-electric conversion plus heat-sales revenue"
    ],
    "eliminated_costs": [
      "No HTS confinement magnets — REBCO supply chain bottleneck does not apply",
      "No plasma heating systems (CAS23) — accelerator is the driver",
      "No target factory / single-shot target fabrication (continuous catalytic process)",
      "No high-vacuum plasma vessel or plasma-facing component cost category",
      "No beryllium-based FLiBe blanket required if Li-only blanket is selected"
    ],
    "novel_costs": [
      "GeV-class CW superconducting proton accelerator (~$5B baseline; ~82% of overnight capital)",
      "Active-target muon source with ML-optimized geometry — no fusion-industry cost analogue",
      "Cryoplant scaled for SC linac cavities rather than confinement magnets",
      "Commercial-scale DT compression target system replacing laboratory diamond anvil cell",
      "Muon beam optics, focusing, and injection hardware into the DT target"
    ],
    "risks": [
      {
        "description": "Energy balance fails: at Acceleron's stated 2.5 GeV / 200 fusions-per-muon operating point, Q_sci ≈ 1.41 and gross/driver ratio ≈ 0.78, making the plant a net energy sink regardless of capital cost",
        "severity": "high"
      },
      {
        "description": "Alpha-sticking physics ceiling caps fusions/muon at ~200–350; Acceleron's 300 target sits near the top of this range and cannot be improved by engineering",
        "severity": "high"
      },
      {
        "description": "Accelerator capital cost dominates LCOE (~82% of overnight capital at $5B); commercial target requires ~20× reduction from SNS-class science facilities with no demonstrated industrial manufacturing pathway",
        "severity": "high"
      },
      {
        "description": "Fusion chamber architecture is undefined — diamond anvil cell is a laboratory instrument and cannot scale; compressed-gas alternatives exist only on paper",
        "severity": "high"
      },
      {
        "description": "47% recirculating power fraction is a model output, not a measured result; no Q value or net energy balance demonstrated at any scale",
        "severity": "high"
      },
      {
        "description": "Tritium breeding blanket type, TBR target, and extraction approach undisclosed; tritium self-sufficiency unproven for non-plasma chamber geometry",
        "severity": "medium"
      },
      {
        "description": "No published O&M cost structure, capacity factor, or maintenance model; particle-physics accelerator availability (85–95%) is for science missions, not power generation",
        "severity": "medium"
      },
      {
        "description": "Tritium startup inventory (~1 kg at >$35,000/g) and declining global supply (~25–30 kg, decaying 5.5%/yr) shared with all D-T concepts",
        "severity": "medium"
      },
      {
        "description": "DT cycling rate data from PSI 2024 campaign described as 'preliminary' and not yet published; key throughput parameter unvalidated",
        "severity": "medium"
      },
      {
        "description": "Regulatory framework for non-plasma D-T nuclear facility undefined; Stewart & Shirvan 2.2× building-cost multiplier may apply",
        "severity": "low"
      }
    ]
  },
