  "parameter_metadata": {},
  "narrative": {
    "key_bets": [
      "Confinement scaling extrapolates 240× from LDX (14.5 ms) to required τ_e = 3.5 s under Bohm-like or better scaling, validated by Tahi prototype (~2028)",
      "Q_sci = 15 operating point achievable in a high-β levitated dipole geometry",
      "ICRH coupling at 70% wall-plug efficiency works in a dipole field topology (undemonstrated; ECRH/NBI as fallbacks)",
      "Annual sacrificial coil replacement cycle (outer ~20% of REBCO coil) is operationally and economically viable under neutron activation",
      "Levitated HTS coil sustains 23 T peak field with on-board flux pump scaled from ~600 A demonstrated to 29.4 kA operating current",
      "Li₂O solid ceramic blanket achieves TBR = 1.1 with natural (unenriched) lithium via tungsten neutron multiplication",
      "Layered W-B₄C-W shield protects REBCO tape with 4-decade fast neutron flux attenuation while operating tungsten tiles at 1950 K above recrystallization"
    ],
    "eliminated_costs": [
      "No disruption mitigation system, thermal dump resistors, or disruption-driven first-wall fatigue (no plasma current → mechanically cannot disrupt)",
      "No thermal energy storage required for grid decoupling during disruptions",
      "No dedicated divertor or high-frequency divertor module replacement cycle (first wall heat flux 0.198 MW/m² vs. 1–2.5 MW/m² at tokamak divertors)",
      "No Li-6 isotope enrichment cost (natural Li₂O suffices)",
      "No central solenoid, toroidal field coils, or external PF coil set (single levitated coil replaces 16–18 tokamak coils)"
    ],
    "novel_costs": [
      "Annual sacrificial coil replacement: ~864 km/yr REBCO tape plus remote handling, qualification testing, and spare pool logistics (~$52M/yr at $75/kA-m baseline)",
      "Remote handling system for activated, neutron-irradiated levitated HTS coil with hot-cell refurbishment capability",
      "Onboard neon slush cryogenic reservoir system with rapid drain-and-refill docking cycle (45-minute float time)",
      "HTS flux pump scaled to deliver 20+ GJ stored energy without current leads during levitated operation",
      "Tritium accounting and inventory management during periodic core magnet docking through the blanket region"
    ],
    "risks": [
      {
        "description": "Confinement scaling extrapolation of 240× from LDX to required τ_e = 3.5 s is unvalidated; if Tahi fails to demonstrate Bohm-like scaling, Reactor A is nonviable as designed (binary viability threshold)",
        "severity": "high"
      },
      {
        "description": "Annual sacrificial coil replacement cost is unquantified; at $75/kA-m tape, raw cost ~$47M/yr (~30% of annual capital charge), spanning ~2× LCOE uncertainty",
        "severity": "high"
      },
      {
        "description": "ICRH coupling in dipole field geometry is undemonstrated; fallback to ECRH at 30–40% efficiency cuts net output 23–41% (208 MWe → 123–160 MWe)",
        "severity": "high"
      },
      {
        "description": "Plasma edge physics uncharacterized — edge temperature/pressure bounds borrowed from I-mode tokamak data, not dipole experiments; tighter edge limits propagate directly to Q_sci and recirculating power",
        "severity": "high"
      },
      {
        "description": "Absolute overnight capital cost and LCOE figures withheld by OpenStar; no independent TEA, system-code, or cost-model anchor exists for the concept",
        "severity": "high"
      },
      {
        "description": "REBCO tape supply chain insufficient at fleet scale — global production ~1,000–2,000 km/yr against ~5,520 km initial + ~864 km/yr recurring per Reactor A",
        "severity": "medium"
      },
      {
        "description": "Thermal cycle (Rankine vs. sCO₂) unspecified despite 40% η_th assumption; 5 pp efficiency reduction lowers net output ~12% and raises LCOE proportionally",
        "severity": "medium"
      },
      {
        "description": "Tungsten tiles operating at 1950 K above recrystallization temperature have unproven long-term creep behavior under 14 MeV neutron irradiation",
        "severity": "medium"
      },
      {
        "description": "REBCO critical current at 23 T, 30 K under combined mechanical stress and neutron irradiation not characterized (existing data only to ~10–12 T)",
        "severity": "medium"
      },
      {
        "description": "Neon supply chain unassessed at fleet scale; global production ~200,000 m³/yr from limited air-separation operators (hydrogen fallback requires 5× larger reservoir)",
        "severity": "medium"
      },
      {
        "description": "First wall lifetime under combined neutron irradiation and thermal cycling not addressed; paper treats first wall as semi-permanent infrastructure without quantification",
        "severity": "medium"
      },
      {
        "description": "Tritium accounting during annual docking cycles (core magnet passing through blanket region) not addressed in published materials",
        "severity": "low"
      }
    ]
  },
