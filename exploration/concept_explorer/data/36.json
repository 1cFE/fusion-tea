  "parameter_metadata": {},
  "narrative": {
    "key_bets": [
      "H = 1.3 confinement improvement factor above ISS04 scaling transfers from W7-X (quasi-isodynamic) to HESTIA's heliotron geometry",
      "sCO₂ Brayton power cycle achieves >50% thermal-to-electric efficiency at 800–1200 K, fusion-coupled at plant scale",
      "Continuous helical WISE REBCO HTS coils can be wound at reactor scale (R₀ = 7.8 m) from uninterrupted kilometer-length tape",
      "Tin-indium-lead-lithium liquid metal blanket with 80 at.% Li-6 enrichment achieves TBR > 1.0 in heliotron geometry",
      "250 GHz / 1 MW CW gyrotrons can be developed to deliver 20 MW absorbed ECRH heating",
      "Non-magnetic high-Mn austenitic structural steel is qualified for fusion-neutron service at 800–1200 K",
      "Fleet manufacturing of 70 MWe modular units drives NOAK learning-curve economics to commercial viability"
    ],
    "eliminated_costs": [
      "Current-drive recirculating power — stellarator topology eliminates the 10–30% gross-electric overhead present in steady-state tokamaks",
      "Liquid helium cryogenics at 4 K — 20 K HTS operation with gas helium cooling dramatically reduces helium supply cost",
      "Plasma restart and pulsed-cycle losses — ~1-year continuous burn eliminates thermal cycling and startup costs of pulsed concepts",
      "In-vessel remote handling robotics — 90 modular LM blanket modules are designed for upper-port crane access",
      "Separate first-wall and divertor replacement programs — integrated flowing LM first wall eliminates solid PFC replacement category"
    ],
    "novel_costs": [
      "Continuous kilometer-scale helical HTS coil winding — no modular joint option; requires unbroken REBCO tape and bespoke manufacturing machine (Sugino)",
      "Tin-indium-lead-lithium alloy blanket including potentially supply-constrained indium (~900 tonnes/yr global production)",
      "80 at.% Li-6 enrichment — the highest enrichment fraction in the portfolio, against constrained global enrichment capacity",
      "250 GHz / 1 MW CW gyrotron development — technology does not exist at any scale; 60 units required",
      "Solar H₂ plant for startup power and HTS magnet cooling — capital not present in any other concept",
      "Non-magnetic high-Mn austenitic structural steel qualification — new nuclear material with no industrial production baseline"
    ],
    "risks": [
      {
        "description": "Published construction cost uses 1990s LHD/ITER pricing requiring ×2+ inflation correction; inflation-adjusted ~$10B for 70 MWe implies ~$143B/GWe specific capital, the highest in the portfolio, driving upper-bound LCOE near $1,800/MWh",
        "severity": "high"
      },
      {
        "description": "sCO₂ Brayton >50% efficiency is load-bearing for Q_eng = 2.0; only 20 kWe at 20% has been demonstrated, peer stellarator FPP (Helios) chose 40% Rankine instead, and below ~32% break-even the design cannot close",
        "severity": "high"
      },
      {
        "description": "Continuous helical WISE HTS coils require unbroken kilometer-scale REBCO tape runs with no fallback if a long-run tape fails during winding; current October 2025 prototype is only >4 m",
        "severity": "high"
      },
      {
        "description": "3D neutron transport calculation for TBR not completed; 80 at.% Li-6 assumption unvalidated in complex heliotron geometry with coil intrusions and maintenance ports",
        "severity": "high"
      },
      {
        "description": "250 GHz / 1 MW CW gyrotrons do not exist; frequency is set by HESTIA's field/density and cannot be substituted with 170 GHz (ITER) or 154 GHz (LHD) technology",
        "severity": "high"
      },
      {
        "description": "LM blanket pump power explicitly 'quite unknown' in primary source; directly affects Q_eng with a tight recirculating budget at 70 MWe net",
        "severity": "high"
      },
      {
        "description": "H = 1.3 confinement assumption relies on W7-X (quasi-isodynamic) demonstration transferring to heliotron geometry; alpha confinement, ECH profiles, and turbulent transport may not transfer directly",
        "severity": "medium"
      },
      {
        "description": "Non-magnetic high-Mn austenitic structural steel has no 14 MeV neutron irradiation database and no industrial production baseline; must be qualified in parallel with reactor development",
        "severity": "medium"
      },
      {
        "description": "Indium content of Sn-In-Pb-Li alloy not disclosed; fusion-scale demand for 90 modules could be material relative to ~900 tonnes/year global indium production (byproduct of zinc smelting)",
        "severity": "medium"
      },
      {
        "description": "Economic thesis relies on fleet manufacturing learning curves to reach NOAK costs; total company funding ~$35.3M is a fraction of peers (CFS ~$2.9B) with no quantitative learning-curve basis",
        "severity": "medium"
      },
      {
        "description": "Sudo density limit exceeded at plasma center; off-axis ECH mitigation proposed but adds operational constraints",
        "severity": "medium"
      },
      {
        "description": "Alpha particle confinement assumed ~85% based on prior FFHR analysis; paper flags as 'marginal' at ρ > 0.7",
        "severity": "medium"
      },
      {
        "description": "Small 70–103 MWe plant scale drives inherently high specific capital cost ($/kWe); commercial viability depends on series-production economics not yet demonstrated",
        "severity": "medium"
      }
    ]
  },
