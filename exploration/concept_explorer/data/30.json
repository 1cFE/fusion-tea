  "parameter_metadata": {},
  "narrative": {
    "key_bets": [
      "NIF Hybrid-E ignition physics (Q_sci = 4.13 at 2 MJ) scales favorably from 2 MJ to 10 MJ drive energy to achieve ~51× target gain required for 1.5 GW net output",
      "DPSSL laser capital cost falls from FOAK $700-1,000/J to NOAK ~$100/J ($7B → $1B for 10 MJ system) through learning and semiconductor diode scale-up",
      "Semiconductor laser diode manufacturing scales ~100× current global production at ~100× cost reduction to reach $0.007/W required for economic viability",
      "Target fabrication achieves <$1/target (ideally $0.41/target NOAK per Goodin 2004) at 315 million indirect-drive lead hohlraum targets per year",
      "Chamber clearing, debris management, and final optics survive 10 Hz operation with 450 MJ fusion energy per shot — no IFE has operated at this duty cycle",
      "Laser diode MTTF reaches 14-20 GShots (7-10× improvement over current devices) to avoid multi-billion-dollar replacement every 4-9 years",
      "Plant availability reaches LIFE heritage target ≥92% despite cumulative fluence damage on monthly timescales at 10 Hz operation"
    ],
    "eliminated_costs": [
      "No superconducting magnets or REBCO HTS tape (largest MFE capital item entirely absent)",
      "No cryogenic systems for magnet cooling",
      "No plasma heating systems (NBI, ECRH, ICRH) — laser is both driver and heating source",
      "No gold hohlraums — lead substitution eliminates supply-limited precious metal dependency at 315M targets/year",
      "No high-field magnet structural support or quench protection systems"
    ],
    "novel_costs": [
      "DPSSL laser driver ~$7B FOAK ($700-1,000/J at 10 MJ) — dominant capital line with no heritage at scale",
      "Target fabrication facility at 315M targets/year throughput (~$150-200M capital, lead hohlraum mass production with no industrial precedent)",
      "Periodic laser diode bulk replacement ($2.3B diode sub-cost every 4-9 years at current lifetimes) — modeled as periodic capital, not annualized O&M",
      "Target material consumables ($315M/yr at $1/target × 315M targets/yr) — consumable-driven O&M unlike MFE staffing-driven structure",
      "Final focusing optics replacement under X-ray/neutron/debris loading at 10 Hz (no validated protection scheme, unspecified by Inertia)"
    ],
    "risks": [
      {
        "description": "Energy balance inconsistency: stated >30× target gain yields only ~440 MWe from a single 1,000-beamline system, not 1,500 MW; ~51× gain or modular multi-chamber architecture required but unconfirmed",
        "severity": "high"
      },
      {
        "description": "Gain scaling from demonstrated 2 MJ NIF shots (peak Q_sci=4.13) to 10 MJ drive energy is physically expected but unanchored in published literature; current peak is 4.4× below 18× pilot threshold",
        "severity": "high"
      },
      {
        "description": "Plant availability at 10 Hz duty cycle unvalidated; dominant LCOE lever (elasticity ~−1.0); diode and optics replacement cycles constrain achievable uptime to plausible 60-92% range",
        "severity": "high"
      },
      {
        "description": "Chamber first wall must simultaneously absorb neutrons, breed tritium, shield X-rays/debris, provide clean laser optical paths, and clear within 100 ms — most complex multi-physics challenge with fewest analogs",
        "severity": "high"
      },
      {
        "description": "Final focusing optics survival under X-ray/neutron/debris loading at 10 Hz unresolved; no material or protective scheme qualified; Inertia has not disclosed approach",
        "severity": "high"
      },
      {
        "description": "Laser diode lifetime gap (current 1.4-2.9 GShots vs. 14-20 GShot requirement) forces multi-billion-dollar replacement every 4-9 years — adds $3.4-$7.2/MWh to LCOE",
        "severity": "high"
      },
      {
        "description": "Target manufacturing at 315M/year with <$1/target cost has no industrial precedent; current experimental targets cost $2,500 (requires ~6,000× cost reduction)",
        "severity": "high"
      },
      {
        "description": "Semiconductor laser diode supply chain must scale 100× current production at 100× cost reduction ($0.7/W → $0.007/W); Inertia's diode engagements are confidential",
        "severity": "medium"
      },
      {
        "description": "Indirect drive coupling efficiency of only ~12% (laser-to-capsule) means 88% of laser energy heats hohlraum/first wall, driving higher driver energy requirements than direct drive",
        "severity": "medium"
      },
      {
        "description": "Tritium extraction from flowing liquid Li is explicitly acknowledged as 'still an area of active development' by Inertia; TBR with beam port penetrations unvalidated",
        "severity": "medium"
      },
      {
        "description": "Li-6 enrichment capacity globally limited (historical Russian/Chinese dominance); enrichment level needed for adequate TBR undisclosed",
        "severity": "medium"
      },
      {
        "description": "Regulatory pathway for pulsed D-T IFE plant uncertain; Stewart & Shirvan 2.2× building cost scenario applies as upper-bound all-fusion risk",
        "severity": "medium"
      },
      {
        "description": "1costingfe framework (tokamak-derived) forces DPSSL and target factory costs into accounts that obscure true cost structure; requires explicit disaggregation of O&M into target, diode replacement, and residual maintenance",
        "severity": "low"
      },
      {
        "description": "Tritium startup inventory scarcity (global civilian ~25 kg, decaying 5.5%/year, >$35,000/g) constrains early plant deployment same as all D-T concepts",
        "severity": "low"
      }
    ]
  },
