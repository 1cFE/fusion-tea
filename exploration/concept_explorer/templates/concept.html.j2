{% extends "base.html.j2" %}

{% block title %}Concept {{ concept_id }} — Fusion TEA{% endblock %}

{% block breadcrumb %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/" class="breadcrumb__item">All Concepts</a>
  <span class="breadcrumb__sep" aria-hidden="true">›</span>
  <span class="breadcrumb__item breadcrumb__item--current" id="breadcrumb-name" aria-current="page">{{ concept_id }}</span>
</nav>
{% endblock %}

{% block body %}
{# Sticky compact headline (concept identity + 4 stats + Reset). Pinned below
   the topnav; populated by sticky_headline.js once concept data loads. Hidden
   until the JS finishes its first render to avoid an empty bar flashing. #}
<div id="sticky-headline" class="sticky-headline" style="display: none;"></div>

<div class="page-content" id="app">

  {# Loading state: visible until both API fetches resolve #}
  <div id="loading-state" class="loading-state" role="status" aria-live="polite">
    <span class="loading-spinner" aria-hidden="true"></span>
    <span class="loading-text">Loading concept…</span>
  </div>

  {# Error state: shown on fetch failure #}
  <div id="error-state" style="display: none;" role="alert" class="error-state">
    Failed to load concept data. Check the server and try again.
  </div>

  {# Main content: hidden until data loads, then revealed atomically #}
  <div id="concept-content" style="display: none;">

    {# Identity hero: name, company, family badge, illustration #}
    <section id="hero" class="hero" aria-label="Concept identity"></section>

    {# In-flow Economics section removed in Phase 3 — its content lives in the
       sticky headline above. Compute-loading and error inline elements are
       retained inline (under the sensitivity section) so concept_page.js can
       still surface compute progress / errors without the old headline-card. #}
    <div id="headline-loading" class="loading-inline" style="display: none;" role="status" aria-live="polite">
      <span class="loading-spinner loading-spinner--sm" aria-hidden="true"></span>
      <span class="loading-text">Recomputing…</span>
    </div>
    <div id="compute-error" style="display: none;" role="alert" class="error-inline"></div>

    {# Sections are collapsible. Headers are <button>s for keyboard accessibility;
       the body is wrapped in `.section__body`. The default-open / default-closed
       state is set in JS (concept_page.js) so it can adapt to per-concept content. #}

    {# Narrative sections: omitted entirely when narrative === null #}
    <section id="narrative-section" style="display: none;" class="section is-collapsed" data-section="narrative">
      <button class="section__header" type="button">
        <svg class="section__chevron" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4 L6 8 L10 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="section__title">Narrative</span>
        <span class="section__hint" data-hint-for="narrative"></span>
      </button>
      <div class="section__body">
        <div id="narrative-content"></div>
      </div>
    </section>

    {# Risks table: omitted entirely when narrative === null or risks empty #}
    <section id="risks-section" style="display: none;" class="section is-collapsed" data-section="risks">
      <button class="section__header" type="button">
        <svg class="section__chevron" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4 L6 8 L10 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="section__title">Risks</span>
        <span class="section__hint" data-hint-for="risks"></span>
      </button>
      <div class="section__body">
        <table id="risks-table" class="risks-table" role="table">
          <thead>
            <tr>
              <th scope="col">Severity</th>
              <th scope="col">Description</th>
              <th scope="col">Retirement Path</th>
            </tr>
          </thead>
          <tbody id="risks-tbody"></tbody>
        </table>
      </div>
    </section>

    {# CAS cost breakdown: omitted when cost_model === null #}
    <section id="cas-section" style="display: none;" class="section is-collapsed" data-section="cas">
      <button class="section__header" type="button">
        <svg class="section__chevron" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4 L6 8 L10 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="section__title">CAS Cost Breakdown</span>
        <span class="section__hint" data-hint-for="cas"></span>
      </button>
      <div class="section__body">
        <div id="cas-mount"></div>
      </div>
    </section>

    {# Sensitivity (tornado): omitted when cost_model === null. Default expanded. #}
    <section id="sensitivity-section" style="display: none;" class="section" data-section="sensitivity">
      <button class="section__header" type="button">
        <svg class="section__chevron" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4 L6 8 L10 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="section__title">Sensitivity &amp; What-If</span>
        <span class="section__hint" data-hint-for="sensitivity">Drag any slider — top numbers will update</span>
      </button>
      <div class="section__body">
        <div id="tornado-mount"></div>
      </div>
    </section>

    {# Agentic Research Key Findings: synthesis exec summary + full analysis.md.
       Hidden by default; concept_page.js shows it after fetching /api/concepts/{id}/findings
       and renders whichever sections are present. Concepts with neither file fall
       through with a brief honest placeholder. #}
    <section id="findings-section" style="display: none;" class="section" data-section="findings">
      <button class="section__header" type="button">
        <svg class="section__chevron" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4 L6 8 L10 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="section__title">Agentic Research Key Findings</span>
      </button>
      <div class="section__body">
        <div id="findings-mount" class="findings-body"></div>
      </div>
    </section>

    {# Add to comparison action #}
    <div class="comparison-actions">
      <a href="/compare" class="btn btn--secondary">Add to Comparison</a>
    </div>

  </div>{# /concept-content #}
</div>{# /app #}

{#
  Inject concept ID as a JS constant — the ONLY server-rendered data on this page.
  All concept data is fetched at runtime via GET /api/concepts/{id}.
#}
<script>
  const CONCEPT_ID = {{ concept_id | tojson }};
</script>
{% endblock %}

{% block scripts %}
{# Component dependencies loaded before concept_page.js #}
<script src="/static/js/concept_label.js"></script>
<script src="/static/js/caveat_marker.js"></script>
<script src="/static/js/ontology_palette.js"></script>
<script src="/static/js/parameter_card.js"></script>
<script src="/static/js/override_panel.js"></script>
<script src="/static/js/tornado.js"></script>
<script src="/static/js/cas_breakdown.js"></script>
<script src="/static/js/sticky_headline.js"></script>
<script src="/static/js/concept_page.js"></script>
{% endblock %}
