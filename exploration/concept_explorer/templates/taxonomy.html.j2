{% extends "base.html.j2" %}

{% block title %}Fusion TEA — Taxonomy Explorer{% endblock %}

{% block body %}
<div id="loading-state" class="loading" style="text-align:center; padding: var(--space-8);">
  Loading taxonomy data...
</div>
<div id="error-state" style="display:none; text-align:center; padding: var(--space-8); color: var(--color-text-muted);">
  Failed to load taxonomy data. Check server logs.
</div>
<div id="taxonomy-content" style="display:none;">
  <div class="taxonomy-layout">
    <!-- Column 1: Collapsible tree -->
    <aside class="taxonomy-sidebar" id="tree-panel">
      <div class="taxonomy-sidebar__header">
        <span class="taxonomy-sidebar__title">Decision Tree</span>
      </div>
      <div id="tree-container"></div>
    </aside>

    <!-- Collapse/expand toggle (positioned on sidebar edge) -->
    <button class="sidebar-toggle" id="sidebar-toggle"
            aria-label="Toggle decision tree" title="Toggle decision tree">&#8249;</button>

    <!-- Column 2: Graph area -->
    <section class="taxonomy-graph" id="graph-area">
      <div class="graph-header" id="graph-header">
        <button class="graph-header__back" id="back-to-overview"
                style="display:none"
                title="Return to design space overview (Esc)">&#8592; Overview</button>
        <span class="graph-header__title" id="graph-title">
          Design Space Overview
        </span>
        <span class="graph-header__subtitle" id="graph-subtitle">
          Concepts positioned by design attribute similarity. Double-click to explore.
        </span>
        <label class="neighbor-count" id="neighbor-count-control" style="display:none">
          <span class="neighbor-count__label">Neighbors</span>
          <select class="neighbor-count__select" id="neighbor-count-select">
            <option value="3">3</option>
            <option value="5" selected>5</option>
            <option value="7">7</option>
            <option value="10">10</option>
          </select>
        </label>
      </div>
      <!-- Constellation (default, Plotly) -->
      <div id="constellation-container" style="min-height: 350px;"></div>
      <!-- Neighborhood graph (on focus, SVG) -->
      <div id="neighborhood-container" style="display:none"></div>
    </section>

    <!-- Column 3: Detail panel (scrollable) -->
    <aside class="taxonomy-detail" id="detail-panel">
      <div id="detail-content">
        <div id="taxonomy-card-container"></div>
        <div id="comparison-container"></div>
      </div>
    </aside>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/vendor/cytoscape.min.js"></script>
<script src="/static/js/tree_view.js"></script>
<script src="/static/js/constellation.js"></script>
<script src="/static/js/taxonomy_card.js"></script>
<script src="/static/js/neighborhood_graph.js"></script>
<script src="/static/js/selection_tray.js"></script>
<script src="/static/js/taxonomy.js"></script>
{% endblock %}
