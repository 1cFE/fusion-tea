<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Fusion TEA — Concept Explorer{% endblock %}</title>
  <link rel="stylesheet" href="/static/css/explorer.css">
  {# Plotly vendored — never load from CDN #}
  <script src="/static/vendor/plotly-basic.min.js"></script>
  {% block head_extra %}{% endblock %}
</head>
<body>
  {#
    Inline SVG defs for hatched fill pattern used by low-confidence bars.
    The pattern id "hatch-low-confidence" is referenced by tornado.js and
    cas_breakdown.js via Plotly fillpattern.fgcolor / custom SVG paths.
    Width/height zero — this element has no layout footprint.
  #}
  <svg class="hatch-pattern-defs" aria-hidden="true">
    <defs>
      <pattern id="hatch-low-confidence"
               patternUnits="userSpaceOnUse"
               width="6" height="6"
               patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6"
              stroke="currentColor"
              stroke-width="2"
              stroke-opacity="0.45"/>
      </pattern>
    </defs>
  </svg>

  <nav class="nav" aria-label="Main navigation">
    <span class="nav__brand">Fusion TEA</span>
    <div class="nav__links">
      <a href="/"
         class="nav__link{% if active_nav == 'concepts' %} nav__link--active{% endif %}"
         aria-current="{% if active_nav == 'concepts' %}page{% else %}false{% endif %}">
        All Concepts
      </a>
      <a href="/compare"
         class="nav__link{% if active_nav == 'compare' %} nav__link--active{% endif %}"
         aria-current="{% if active_nav == 'compare' %}page{% else %}false{% endif %}">
        Compare
      </a>
    </div>
  </nav>

  {% block breadcrumb %}{% endblock %}

  <main>
    {% block body %}{% endblock %}
  </main>

  <footer class="footer">
    <span>Fusion TEA — Techno-Economic Analysis</span>
    <span class="mono">Concept Explorer</span>
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>
