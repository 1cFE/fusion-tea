    calc def 'Network Heat Driven Closure' {
        doc /* **Source**: work/active/WI-092_aries-parallel-exchanger-network/design.md. **Reference**: generic network heat-driven closure; network mode 0 copies the reviewed 'Heat Driven Closure' equations line for line (that definition is retained in this file, unbound by the live assembly), mode 1 evaluates the published series-then-parallel exchanger network (Raffray Fig. 12) with a supplied cycle-flow split that is an operating choice, never a sizing rule. MW/K/MPa/kg/s/J per kg K as documented; mode and split are dimensionless; 0 < split < 1 in both modes. **Last Updated**: 2026-09-25. */
        in attribute cold_temperature_in : Real;
        in attribute flow_in : Real;
        in attribute cp_in : Real;
        in attribute gamma_in : Real;
