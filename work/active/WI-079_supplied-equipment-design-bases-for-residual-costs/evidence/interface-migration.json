  "changed_oracle_formulas": {
    "blanket": "blanket_unit_cost * blanket_structure_factor * blanket_vol * (selected_blanket_cost_thermal_class_MW / p_th_ref) ** alpha_06",
    "shield": "shield_unit_cost * shield_vol * shield_scale * (selected_shield_cost_thermal_class_MW / p_th_ref) ** alpha_06",
    "structure_legacy_cost": "structure_unit_cost * structure_vol * (selected_structure_cost_gross_class_MWe / p_et_ref) ** alpha_05",
    "structure": "structure_residual_fraction * structure_legacy_cost",
    "vessel": "vessel_unit_cost * vessel_vol * (selected_vessel_cost_gross_class_MWe / p_et_ref) ** alpha_06",
    "power_supplies": "selected_power_supplies_purchase_cost_per_module",
    "divertor": "selected_divertor_purchase_cost_per_module",
    "turbine": "n_mod * selected_turbine_purchase_cost_per_module",
    "electric": "n_mod * selected_electric_plant_installed_gross_rating_MWe * electric_per_mw",
    "heat_rejection": "n_mod * selected_heat_rejection_purchase_cost_per_module",
    "misc": "n_mod * selected_misc_plant_cost_gross_class_MWe * misc_per_mw",
    "remote_handling": "remote_handling_base * concept_scale * (selected_remote_handling_cost_gross_class_MWe / rh_p_et_ref) ** rh_alpha",
    "aux_cost": "aux_per_mw * n_mod * selected_cryoplant_aux_cost_thermal_class_MW",
    "cryo_cost": "selected_cryoplant_purchase_cost_per_module",
    "waste": "waste_base * (n_mod * selected_waste_cost_thermal_class_MW / waste_ref) ** waste_alpha",
    "other_rpe": "other_rpe_base * (n_mod * selected_other_rpe_cost_net_class_MWe / other_ref) ** other_alpha",
    "inc": "inc_base * (n_mod * selected_inc_cost_thermal_class_MW / inc_ref) ** inc_alpha",
    "owner": "owner_base * (n_mod * selected_owner_cost_net_class_MWe / owner_ref) ** owner_alpha",
    "annual_om_unlevelized": "om_annual_ref * (selected_om_staffing_net_class_MWe / ref_net_power) ** om_alpha + om_direct; existing om_cost n_mod_in default=1 retained",
    "supplementary": "unchanged freight/spares/tax/insurance bases + supp_startup_base*(n_mod*selected_startup_cost_net_class_MWe/ref_net_power) + supp_decom_base*(n_mod*selected_decom_cost_net_class_MWe/ref_net_power); then existing supplementary contingency",
    "buildings_legacy": "unchanged six-term grouping; p_fus,p_et,p_the,p_th replaced by selected_buildings_legacy_cost_fusion_class_MW, selected_buildings_legacy_cost_gross_class_MWe, selected_buildings_legacy_cost_thermal_electric_class_MWe, selected_buildings_legacy_cost_thermal_class_MW respectively; existing default n_mod=1 retained",
    "precon_legacy": "land_intensity * (selected_precon_legacy_cost_net_class_MWe * ref_net_power)**0.5 * land_cost + precon_fixed_base; existing default n_mod=1 retained",
    "coolant_legacy": "coolant_primary_base*(n_mod*selected_heat_transport_legacy_cost_net_class_MWe/coolant_ref_net) + coolant_intermediate_base*(n_mod*selected_heat_transport_legacy_cost_thermal_class_MW/coolant_p_th_ref)**coolant_alpha",
    "fuel_handling_legacy": "fuel_handling_base*(n_mod*selected_fuel_cycle_legacy_cost_net_class_MWe/fuel_ref)**fuel_alpha"
  },
