SYSIDE_LICENSE_KEY=""
ZOTERO_KEY=""
ZOTERO_ID=""

# --- R2 artifact sync ---
# Binary research artifacts (PDFs, HTML, images) are synced via rclone to Cloudflare R2.
# Get credentials: Cloudflare dashboard → R2 → Manage R2 API Tokens → create Account API Token
# On the success page, copy the Access Key ID and Secret Access Key (below the token value).
R2_ACCESS_KEY=""
R2_SECRET_ACCESS_KEY=""
# Then configure rclone:
#   source .env
#   rclone config create r2 s3 provider Cloudflare \
#     access_key_id "$R2_ACCESS_KEY" secret_access_key "$R2_SECRET_ACCESS_KEY" \
#     endpoint https://985ab2e0dede4b8be7f56c00b861ca9b.r2.cloudflarestorage.com env_auth false
# Then: ./scripts/sync_research.sh pull